# Copiar este archivo como .env, sustituir los valores antes de ejecutar.
MYSQL_ROOT_PASSWORD=CAMBIA_ROOT_POR_UNA_CLAVE_UNICA
MYSQL_DATABASE=agencia_autos
MYSQL_USER=admin
MYSQL_PASSWORD=CAMBIA_SQL_POR_UNA_CLAVE_UNICA
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
ADMIN_INITIAL_USERNAME=developer
ADMIN_INITIAL_PASSWORD=CAMBIA_ADMIN_POR_UNA_CLAVE_UNICA

# Opcional: cambiar nombre de proyecto y puerto para una segunda instalacion local.
COMPOSE_PROJECT_NAME=agencia-automoviles
