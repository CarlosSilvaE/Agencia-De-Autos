digraph "Modelo ER" {
	bgcolor=white nodesep=0.28 pad=0.28 rankdir=LR ranksep=0.85 splines=polyline
	node [color="#a2b8ca" fillcolor="#edf6ff" fontcolor="#203c53" fontname=Arial fontsize=10 shape=record style=filled]
	edge [arrowsize=0.65 color="#567b9f" fontname=Arial fontsize=9]
	administradores [label="{administradores|PK id_administrador\lnombre\lusuario (unico)\lpassword_hash\lactivo\l}"]
	clientes [label="{clientes|PK id_cliente\lnombre\lapellido_paterno\lapellido_materno\ltelefono\lemail\lactivo\l}"]
	marcas [label="{marcas|PK id_marca\lnombre\lactivo\l}"]
	modelos [label="{modelos|PK id_modelo\lFK id_marca\lnombre\lactivo\l}"]
	anios [label="{anios|PK id_anio\lanio\lactivo\l}"]
	vehiculos [label="{vehiculos|PK id_vehiculo\lFK id_cliente\lFK id_marca\lFK id_modelo\lFK id_anio\lplacas (unicas)\lcolor / VIN\lactivo\l}"]
	estados [label="{estados|PK id_estado\lnombre\lactivo\l}"]
	servicios [label="{servicios|PK id_servicio\lfolio (unico)\lFK id_vehiculo\ltipo_servicio\ldescripcion\lfecha_ingreso\lestado (CHECK)\lmano_obra\lcosto total\l}"]
	entregas [label="{entregas|PK id_entrega\lFK id_servicio\lnombre_entrega\ltelefono\lfecha\lobservaciones\l}"]
	proximos_servicios [label="{proximos_servicios|PK id_proximo_servicio\lFK id_servicio\lfecha_programada\lkilometraje\lnotas\l}"]
	refacciones [label="{refacciones|PK id_refaccion\lnombre\lsku\lcantidad\lprecio\lactivo\l}"]
	servicio_refaccion [label="{servicio_refaccion|PK/FK id_servicio\lPK/FK id_refaccion\lcantidad\lprecio_unitario\l}"]
	clientes -> vehiculos [label="1:N"]
	marcas -> modelos [label="1:N"]
	marcas -> vehiculos [label="1:N"]
	modelos -> vehiculos [label="1:N"]
	anios -> vehiculos [label="1:N"]
	vehiculos -> servicios [label="1:N"]
	servicios -> entregas [label="1:N"]
	servicios -> proximos_servicios [label="1:N"]
	servicios -> servicio_refaccion [label="1:N"]
	refacciones -> servicio_refaccion [label="1:N"]
}
