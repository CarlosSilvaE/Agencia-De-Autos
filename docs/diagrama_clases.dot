digraph "Agencia - UML" {
	bgcolor=white fontname=Arial nodesep=0.32 pad=0.25 rankdir=LR ranksep=0.65 splines=spline
	node [color="#9bb8d3" fillcolor="#e9f2fd" fontcolor="#173250" fontname=Arial fontsize=10 margin=0.13 shape=record style=filled]
	edge [arrowsize=0.7 color="#607c99" fontname=Arial fontsize=9]
	Provider [label="{DatabaseProvider (Singleton)|_instance: DatabaseProvider\l_database: MySQLDatabase\l|__new__()\ldatabase\l}"]
	Database [label="{MySQLDatabase|settings: dict\l|connect()\lsession()\ltranslate_error()\l}"]
	Model [label="{AgencyModel|database: MySQLDatabase\lDASHBOARD_STRATEGIES\l|authenticate()\lcreate_service()\lupdate_service()\ldashboard()\lCRUD clientes, catálogos y vehículos\l}"]
	Strategy [label="{DashboardQueryStrategy (ABC)|+build(day)\l}"]
	Total [label="{TotalDashboardStrategy|+build(day)\l}"]
	Daily [label="{DailyDashboardStrategy|+build(day)\l}"]
	Controllers [label="{AgencyControllers (Factory)|auth / dashboard / services\lupcoming / catalogs / admins\l|+from_model(model)\l}"]
	Auth [label="{AuthController|current_user\l|+login()\l+logout()\l}"]
	Services [label="{ServiceController|model\l|+create()\l+update()\l+delete()\l+delivery_history()\l}"]
	DashCtrl [label="{DashboardController|model\l|+summary()\l}"]
	Main [label="{MainWindow|auth controller\l|+logout()\l+closeEvent()\l}"]
	DashPage [label="{DashboardPage|controller / chart\l|+refresh()\l}"]
	Chart [label="{StatusBarChart|_counts\l|+set_counts()\l+paintEvent()\l}"]
	ServiceReceipt [label="{ServiceReceipt (dataclass)|folio / owner / parts\l|+from_records()\l+as_text()\l}"]
	ReceiptPart [label="{ReceiptPart (dataclass)|name / quantity / unit_price\l|+describe()\l}"]
	ServiceDialog [label="{ServiceDialog|vehicles / parts\l|+payload()\l}"]
	Provider -> Database
	Model -> Database
	Model -> Strategy [style=dashed]
	Strategy -> Total [arrowhead=empty dir=back]
	Strategy -> Daily [arrowhead=empty dir=back]
	Controllers -> Auth
	Controllers -> Services
	Controllers -> DashCtrl
	Services -> Model
	DashCtrl -> Model
	Main -> Controllers
	Main -> DashPage
	DashPage -> DashCtrl
	DashPage -> Chart
	Main -> ServiceDialog [style=dashed]
	Model -> ServiceReceipt
	ServiceReceipt -> ReceiptPart
}
